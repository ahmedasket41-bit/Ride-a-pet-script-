-- البحث ببداية الاسم فقط
local function runSearch()
    searchVersion += 1
    local version = searchVersion

    clearResults()

    local query = search.Text:lower():match("^%s*(.-)%s*$")

    if query == "" then
        status.Text = "اكتب أول حرف للبحث"
        return
    end

    status.Text = "جاري البحث..."

    task.spawn(function()
        local found = 0
        local checked = 0

        for _, obj in ipairs(index) do
            if version ~= searchVersion then return end
            checked += 1

            if obj.Parent
                and obj.Name:lower():sub(1, #query) == query then

                found += 1

                local button = Instance.new("TextButton")
                button.Name = "Result" .. found
                button.LayoutOrder = found
                button.Size = UDim2.new(1, -4, 0, 40)
                button.BackgroundColor3 =
                    Color3.fromRGB(37, 52, 48)
                button.Text = "🥚  " .. obj.Name
                button.TextColor3 = GREEN
                button.TextSize = 14
                button.Font = Enum.Font.GothamBold
                button.Parent = results
                round(button, 8)

                button.Activated:Connect(function()
                    selectEgg(obj)
                end)

                if found >= 150 then break end
            end

            if checked % 100 == 0 then
                task.wait()
            end
        end

        if version ~= searchVersion then return end

        status.Text = found == 0
            and "لا توجد بيضات تبدأ بهذا النص"
            or ("عدد النتائج: " .. found)
    end)
end

-- فهرسة العناصر على دفعات
task.spawn(function()
    local descendants = Workspace:GetDescendants()

    for i, obj in ipairs(descendants) do
        indexObject(obj)
        if i % 200 == 0 then task.wait() end
    end

    status.Text = "اكتب أول حرف للبحث"
end)

Workspace.DescendantAdded:Connect(function(obj)
    task.defer(function()
        if obj.Parent then indexObject(obj) end
    end)
end)

Workspace.DescendantRemoving:Connect(function(obj)
    indexed[obj] = nil

    for i = #index, 1, -1 do
        if index[i] == obj then
            table.remove(index, i)
        end
    end

    if selectedEggObject == obj then
        clearSelection()
    end
end)

search:GetPropertyChangedSignal("Text"):Connect(runSearch)

toggle.Activated:Connect(function()
    main.Visible = not main.Visible
end)

close.Activated:Connect(function()
    main.Visible = false
end)

-- سحب الزر والقائمة
local function makeDraggable(handle, target)
    local dragging = false
    local startInput
    local startPosition
    local activeInput

    handle.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.Touch
            or input.UserInputType == Enum.UserInputType.MouseButton1 then

            dragging = true
            startInput = input.Position
            startPosition = target.Position
            activeInput = input
        end
    end)

    UIS.InputChanged:Connect(function(input)
        if not dragging then return end

        local mouseMove =
            input.UserInputType == Enum.UserInputType.MouseMovement

        local touchMove =
            activeInput
            and activeInput.UserInputType == Enum.UserInputType.Touch
            and input.UserInputType == Enum.UserInputType.Touch

        if mouseMove or touchMove then
            local delta = input.Position - startInput

            target.Position = UDim2.new(
                startPosition.X.Scale,
                startPosition.X.Offset + delta.X,
                startPosition.Y.Scale,
                startPosition.Y.Offset + delta.Y
            )
        end
    end)

    UIS.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.Touch
            or input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = false
            activeInput = nil
        end
    end)
end

