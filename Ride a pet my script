-- فهرس البيض
local index = {}
local indexed = {}
local selectedHighlight
local selectedTag
local selectedEggObject
local searchVersion = 0

local function isEgg(obj)
    if not (obj:IsA("Model") or obj:IsA("BasePart")) then
        return false
    end

    local name = obj.Name:lower()
    return name:find("egg", 1, true) ~= nil
        or name:find("بيض", 1, true) ~= nil
end

local function indexObject(obj)
    if indexed[obj] or not isEgg(obj) then return end
    indexed[obj] = true
    table.insert(index, obj)
end

local function getPart(obj)
    if obj:IsA("BasePart") then
        return obj
    end

    if obj:IsA("Model") then
        return obj.PrimaryPart
            or obj:FindFirstChildWhichIsA("BasePart", true)
    end
end

local function clearSelection()
    if selectedHighlight then
        selectedHighlight:Destroy()
    end

    if selectedTag then
        selectedTag:Destroy()
    end

    selectedHighlight = nil
    selectedTag = nil
    selectedEggObject = nil
end

-- تحديد البيضة والانتقال إليها دون الرجوع
local function selectEgg(obj)
    if not obj or not obj.Parent then return end

    local part = getPart(obj)
    if not part then
        status.Text = "لا يوجد جزء قابل للتحديد"
        return
    end

    local character = player.Character
    local root = character
        and character:FindFirstChild("HumanoidRootPart")

    if not root or not part:IsDescendantOf(Workspace) then
        status.Text = "تعذر الانتقال إلى البيضة"
        return
    end

    clearSelection()
    selectedEggObject = obj

    -- التحديد الأخضر
    selectedHighlight = Instance.new("Highlight")
    selectedHighlight.Adornee = obj
    selectedHighlight.FillColor = GREEN
    selectedHighlight.OutlineColor = Color3.new(1, 1, 1)
    selectedHighlight.FillTransparency = 0.25
    selectedHighlight.DepthMode =
        Enum.HighlightDepthMode.AlwaysOnTop
    selectedHighlight.Parent = Workspace

    -- اسم البيضة
    selectedTag = Instance.new("BillboardGui")
    selectedTag.Adornee = part
    selectedTag.Size = UDim2.fromOffset(180, 38)
    selectedTag.StudsOffsetWorldSpace = Vector3.new(0, 3, 0)
    selectedTag.AlwaysOnTop = true
    selectedTag.Parent = gui

    local label = Instance.new("TextLabel")
    label.Size = UDim2.fromScale(1, 1)
    label.BackgroundColor3 = Color3.fromRGB(12, 30, 20)
    label.BackgroundTransparency = 0.1
    label.Text = "🥚 " .. obj.Name
    label.TextColor3 = GREEN
    label.TextStrokeTransparency = 0.3
    label.TextScaled = true
    label.Font = Enum.Font.GothamBold
    label.Parent = selectedTag
    round(label, 8)

    -- الانتقال للبيضة والبقاء هناك
    character:PivotTo(
        CFrame.new(part.Position + Vector3.new(0, 5, 0))
    )

    status.Text = "وصلت إلى: " .. obj.Name
end

